{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./",
    "paths": {
      "@mint/core": ["packages/core/src/index.ts"],
      "@mint/core/*": ["packages/core/src/*"],
      "@mint/ingest": ["packages/ingest/src/index.ts"],
      "@mint/ingest/*": ["packages/ingest/src/*"],
      "@mint/cli": ["packages/cli/src/index.ts"],
      "@mint/cli/*": ["packages/cli/src/*"]
    }
  },
  "include": ["src", "scripts", "tests", "packages"]
}
