# API Key y configuración del gateway de Grok (xAI)
RETO_KEY=
GROK_BASE_URL=https://api.reto.pltk.mx/v1
GROK_MODEL=grok-4.6

# Configuración de PostgreSQL en Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_back_office
POSTGRES_PORT=5432

# URL de conexión a la base de datos (utilizada por Drizzle ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_back_office
