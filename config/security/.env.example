# MINT AI Back-Office - Security & Environment Configuration Template

# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Database Credentials
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_back_office

# Grok / LLM API Configuration
GROK_API_KEY=your_grok_api_key_here
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# Challenge & Reto Security Keys
RETO_KEY=your_reto_key_here

# Pino Logger Level
LOG_LEVEL=info
