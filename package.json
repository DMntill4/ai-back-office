    "db:seed": "tsx src/db/seed/index.ts",
    "db:reset": "tsx scripts/clear-db.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"tsx src/server.ts\" \"npm run dev --prefix frontend\"",
    "dev:backend": "tsx src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "server": "tsx src/server.ts",
    "mint": "tsx src/cli/index.ts"
  },
