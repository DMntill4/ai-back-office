{
  "name": "ai-back-office",
  "version": "1.0.0",
  "description": "Mint CLI: Autonomous Multi-Agent Logistics Coordinator",
  "main": "index.js",
  "bin": {
    "mint": "./packages/cli/bin/mint.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:pull": "drizzle-kit introspect",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx packages/core/src/db/seed/index.ts",
    "db:reset": "tsx scripts/clear-db.ts",
    "db:studio": "drizzle-kit studio",
    "start": "tsx packages/cli/src/index.ts start",
    "agent": "tsx packages/cli/src/index.ts start",
    "agent:headless": "tsx packages/cli/src/index.ts start --headless",
    "dev": "tsx packages/cli/src/index.ts start",
    "console": "tsx packages/cli/src/index.ts console",
    "mint": "tsx packages/cli/src/index.ts",
    "api": "tsx packages/api/src/index.ts",
    "web": "npm run dev --workspace=@mint/web",
    "web:build": "npm run build --workspace=@mint/web",
    "studio": "npm run dev --workspace=@mint/web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DMntill4/ai-back-office.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DMntill4/ai-back-office/issues"
  },
  "homepage": "https://github.com/DMntill4/ai-back-office#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "5.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.7",
    "@supabase/supabase-js": "^2.118.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.6",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "openai": "^7.30.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "xlsx": "^0.18.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
